// Agentic Office — v10 primary film (76 s). Script: projects/agentic-office-false-promise/brief/SCRIPT_v10.md
// Frame rule: one idea per frame, every message ≥2.5 s, ≥42 px. Real UI = unaltered ui3 frames (graphics only on top).
import React from "react";
import { AbsoluteFill, Audio, Easing, Img, interpolate, OffthreadVideo, Sequence, spring, staticFile, useCurrentFrame, useVideoConfig } from "remotion";
import { Line, Plate, Sfx, Shot } from "./AODone";

const FPS = 30;
const s = (sec: number) => Math.round(sec * FPS);
const a = (p: string) => staticFile(`aofp/${p}`);
const clamp = { extrapolateLeft: "clamp", extrapolateRight: "clamp" } as const;
export const ui = "Inter, -apple-system, 'SF Pro Text', Helvetica, Arial, sans-serif";
const serif = "'Times New Roman', Georgia, serif";
export const C = { bg: "#0b0d12", win: "#16191f", bar: "#1f232b", line: "#2b313c", text: "#e9ebf0", dim: "#8d94a3", blue: "#3b7bff", red: "#ff5a5a", green: "#35d07f", amber: "#ffb020", teal: "#0f3b3c" };

export type AOv10Props = { n2?: string; diffs?: boolean };

// ---------- shared screen pieces ----------
export const Desk: React.FC<{ children: React.ReactNode }> = ({ children }) => (
  <AbsoluteFill style={{ background: "radial-gradient(ellipse at 50% 40%, #1a2030, #07090d 75%)", justifyContent: "center", alignItems: "center", fontFamily: ui }}>{children}</AbsoluteFill>
);

export const Win: React.FC<{ title: string; w: number; h: number; children: React.ReactNode; style?: React.CSSProperties }> = ({ title, w, h, children, style }) => (
  <div style={{ width: w, height: h, background: C.win, borderRadius: 18, border: `1px solid ${C.line}`, boxShadow: "0 40px 120px rgba(0,0,0,.6)", overflow: "hidden", position: "relative", ...style }}>
    <div style={{ height: 52, background: C.bar, display: "flex", alignItems: "center", padding: "0 20px", gap: 10 }}>
      {["#ff5f57", "#febc2e", "#28c840"].map((c) => <div key={c} style={{ width: 14, height: 14, borderRadius: 7, background: c }} />)}
      <div style={{ marginLeft: 14, color: C.dim, fontSize: 24 }}>{title}</div>
    </div>
    <div style={{ padding: 34 }}>{children}</div>
  </div>
);

export const Label: React.FC<{ text: string; color?: string; at?: number; y?: number }> = ({ text, color = C.amber, at = 0, y = 70 }) => {
  const f = useCurrentFrame();
  return (
    <div style={{ position: "absolute", left: 0, right: 0, bottom: y, textAlign: "center", opacity: interpolate(f, [at, at + 6], [0, 1], clamp) }}>
      <span style={{ fontFamily: ui, fontWeight: 800, fontSize: 52, color, background: "rgba(5,7,10,.78)", padding: "12px 30px", borderRadius: 14, letterSpacing: -0.5 }}>{text}</span>
    </div>
  );
};

export const Pin: React.FC<{ text: string }> = ({ text }) => (
  <div style={{ position: "absolute", top: 40, left: "50%", transform: "translateX(-50%)", background: "#232a38", border: `1px solid ${C.blue}`, color: C.text, fontFamily: ui, fontSize: 34, padding: "12px 24px", borderRadius: 12, whiteSpace: "nowrap", zIndex: 5 }}>
    <span style={{ color: C.dim, marginRight: 12 }}>AI chat said:</span>{text}
  </div>
);

export const Bubble: React.FC<{ who: "ai" | "me"; children: React.ReactNode; style?: React.CSSProperties }> = ({ who, children, style }) => (
  <div style={{ alignSelf: who === "me" ? "flex-end" : "flex-start", maxWidth: "88%", background: who === "me" ? C.blue : "#222833", color: "white", borderRadius: 22, padding: "22px 30px", fontSize: 44, lineHeight: 1.35, ...style }}>{children}</div>
);

// Teal board-deck slide (hers) — styled after the real Board Pack Q3 deck.
export const TealSlide: React.FC<{ w: number; title: string; box: string; boxRing?: number }> = ({ w, title, box, boxRing = 0 }) => {
  const k = w / 900;
  return (
    <div style={{ width: w, height: w * 0.5625, background: C.teal, borderRadius: 10 * k, position: "relative", fontFamily: ui, overflow: "hidden", boxShadow: "0 30px 80px rgba(0,0,0,.5)" }}>
      <div style={{ position: "absolute", left: 50 * k, top: 40 * k, width: 70 * k, height: 5 * k, background: "#4fd1c5" }} />
      <div style={{ position: "absolute", left: 50 * k, top: 60 * k, color: "white", fontSize: 44 * k, fontWeight: 700 }}>{title}</div>
      {[60, 72, 80, 96].map((hh, i) => (
        <div key={i} style={{ position: "absolute", left: (90 + i * 95) * k, bottom: 120 * k, width: 60 * k, height: hh * 2 * k, background: i === 3 ? "#4fd1c5" : "#6fa8a8", borderRadius: 3 * k }} />
      ))}
      <div style={{ position: "absolute", left: 90 * k, bottom: 62 * k, color: "#cfe7e6", fontSize: 22 * k }}>FY23 · FY24 · FY25 · FY26</div>
      <div style={{ position: "absolute", right: 50 * k, bottom: 60 * k, width: 330 * k, padding: `${12 * k}px ${18 * k}px`, border: `1px solid rgba(255,255,255,.35)`, color: "white", fontSize: 36 * k }}>
        FY26 outlook: {box}
        {boxRing > 0 && <svg style={{ position: "absolute", left: -30 * k, top: -26 * k, overflow: "visible" }} width={400 * k} height={130 * k}><ellipse cx={200 * k} cy={65 * k} rx={195 * k} ry={60 * k} fill="none" stroke={C.red} strokeWidth={7 * k} strokeDasharray={1100 * k} strokeDashoffset={1100 * k * (1 - boxRing)} /></svg>}
      </div>
    </div>
  );
};

// ---------- Act 1–3 beats ----------
export const B1Hook: React.FC = () => (
  <Desk>
    <Win title="AI chat" w={1500} h={720}>
      <div style={{ display: "flex", flexDirection: "column", gap: 22 }}>
        <Bubble who="me" style={{ fontSize: 40 }}>Update my model, memo and deck to the new FY26 number.</Bubble>
        <Bubble who="ai" style={{ fontSize: 54 }}>
          <b>Here's what to change:</b>
          <div style={{ marginTop: 18, fontSize: 52 }}>Memo: <span style={{ color: C.red, textDecoration: "line-through" }}>€71–73m</span> → <span style={{ color: C.green, fontWeight: 800 }}>€74.6m</span></div>
          <div style={{ marginTop: 10, fontSize: 40, color: "#b8c0cf" }}>Model: Revenue!E6 → 8.5 · Deck: slide 2 title → €74.6m</div>
        </Bubble>
      </div>
    </Win>
  </Desk>
);

const FileRow: React.FC<{ icon: string; color: string; name: string; meta: string; metaColor?: string }> = ({ icon, color, name, meta, metaColor = C.dim }) => (
  <div style={{ display: "flex", alignItems: "center", gap: 24, padding: "20px 10px", borderBottom: `1px solid ${C.line}`, fontSize: 40 }}>
    <div style={{ width: 54, height: 54, borderRadius: 10, background: color, color: "white", fontWeight: 800, fontSize: 30, display: "flex", alignItems: "center", justifyContent: "center" }}>{icon}</div>
    <div style={{ flex: 1, color: C.text }}>{name}</div>
    <div style={{ color: metaColor }}>{meta}</div>
  <AbsoluteFill style={{ background: "#000" }}>
    {/* ACT 1 · THE CONTRADICTION */}
    <Shot at={0} dur={3}><B1Hook /></Shot><Line at={0.25} id="v1" />
    <Shot at={3} dur={3}><B2Folder /></Shot><Line at={3.25} id="v2" />
    <Shot at={6} dur={5.5}><B3David /></Shot>
    <Sfx at={6.05} src="sfx/buzz.wav" vol={0.7} /><Sfx at={8.55} src="sfx/buzz.wav" vol={0.7} />
    <Shot at={11.5} dur={2.5}>{n2 ? <Plate src={n2} push={0.03} /> : <Plate src="g02.mp4" from={3.0} push={0.03} />}</Shot>
    <Line at={11.6} id="v3" />

    {/* ACT 2 · YOU DRIVE (no narration; low pulse) */}
    <Shot at={14} dur={3}><B5Excel /></Shot><Sfx at={14.15} src="sfx/mixkit_2531.mp3" vol={0.5} dur={0.6} />
    <Shot at={17} dur={3}><B6Word /></Shot><Sfx at={17.05} src="sfx/mixkit_1113.mp3" vol={0.6} />
    <Shot at={20} dur={2.5}><B7ChatDeck /></Shot>
    <Shot at={22.5} dur={3}><B8Compare /></Shot>
    <Shot at={25.5} dur={3}><B9HerSlide /></Shot><Sfx at={28.2} src="sfx/mixkit_1492.mp3" vol={0.5} />

    {/* ACT 3 · THE PUNCH */}
    <Shot at={28.5} dur={3.5}><B10Punch /></Shot><Sfx at={28.55} src="sfx/buzz.wav" vol={0.8} />
    <Shot at={32} dur={3}><B11Receipt /></Shot><Line at={32.3} id="v4" />

    {/* ACT 4 · IT DRIVES */}
    <Shot at={35} dur={2.5}><Card text={diffs ? "Introducing Diffs in Agentic Office." : "Same request. This time, Agentic Office."} /></Shot>{diffs && <Line at={35.1} id="d_intro" />}
    {[
      { t: 37.5, m: { x: 1642, y: 316, w: 254, h: 40 }, q: "“Take DACH Q4 down to 8.5 in the model,”" },
      { t: 40.0, m: { x: 1642, y: 336, w: 254, h: 60 }, q: "“then make the memo and the deck match the new FY26 number.”" },
      { t: 42.5, m: { x: 1744, y: 374, w: 150, h: 22 }, q: "“Show me the diffs.”" },
    ].map(({ t, m, q }) => (
      <Shot key={t} at={t} dur={2.5}>
        <Freeze img="u3_22.png" {...BUBBLE} fill={0.82}>
          <Mark kind="spot" {...m} fx={BUBBLE.x} fy={BUBBLE.y} fw={BUBBLE.w} fh={BUBBLE.h} fill={0.82} />
          <div style={{ position: "absolute", left: 0, right: 0, bottom: 150, textAlign: "center" }}><span style={{ fontFamily: ui, fontSize: 54, fontWeight: 700, color: "white", background: "rgba(5,7,10,.85)", padding: "10px 26px", borderRadius: 12 }}>{q}</span></div>
          <Footer text="Update the model, memo and deck. Show the diffs." />
        </Freeze>
      </Shot>
    ))}
    <Line at={37.8} id="v5" />
    <Shot at={45} dur={1}><Freeze video="ui3.mp4" from={24.9} x={575} y={474} w={420} h={46} fill={0.95} /></Shot>
    <Shot at={46} dur={2.5}><Freeze img="u3_25.9.png" x={575} y={474} w={420} h={46} fill={0.95}><Label text={diffs ? "A diff, in her own memo." : "Proposed, in her own memo."} color={C.green} y={60} /></Freeze></Shot>
    <Shot at={48.5} dur={3}><Freeze video="ui3.mp4" from={28} x={330} y={100} w={1260} h={720} fill={1}><Label text="Still your deck." color={C.green} /><div style={{ position: "absolute", top: 30, right: 40, fontFamily: ui, fontSize: 26, color: "rgba(255,255,255,.8)", background: "rgba(0,0,0,.5)", padding: "6px 12px", borderRadius: 8 }}>Real app · sped up</div></Freeze></Shot>

    {/* ACT 5 · YOU APPROVE — four holds on the same unaltered freeze, then the real click */}
    <Shot at={51.5} dur={3}><Freeze img="u3_39.2.png" x={1630} y={255} w={290} h={310} fill={0.9} /></Shot>
    <Shot at={54.5} dur={3}><Freeze img="u3_39.2.png" x={1630} y={760} w={290} h={110} fill={0.9}><Mark kind="ring" x={1640} y={790} w={270} h={50} fx={1630} fy={760} fw={290} fh={110} fill={0.9} /></Freeze></Shot>
    <Shot at={57.5} dur={3}><Freeze img="u3_39.2.png" x={1630} y={905} w={290} h={110} fill={0.9}><Mark x={1833} y={940} w={62} h={36} fx={1630} fy={905} fw={290} fh={110} fill={0.9} /><Label text={diffs ? "Each diff: accept or reject." : "Each change: accept or reject."} y={110} /></Freeze></Shot>{diffs && <Line at={57.6} id="d_each" />}
    <Shot at={60.5} dur={1.4}><Freeze video="ui3.mp4" from={39.4} {...PANEL} fill={0.95} /></Shot>
    <Shot at={61.9} dur={2.6}><Freeze img="u3_40.8.png" {...PANEL} fill={0.95} /></Shot>
    <Sfx at={60.9} src="sfx/mixkit_2568.mp3" /><Line at={61.6} id="v6" />
    <Shot at={64.5} dur={3}><Freeze img="u3_43.9.png" x={575} y={470} w={480} h={130} fill={0.9}><Label text="Memo and table: €74.6m." color={C.green} y={40} /></Freeze></Shot>
    <Shot at={67.5} dur={3}><Plate src="g05.mp4" from={0.8} push={0.03} /></Shot>
    <Shot at={70.5} dur={5.5}>{diffs ? <DiffsEndCard /> : <EndCard />}</Shot><Line at={70.6} id={diffs ? "d_end" : "v7"} />

    {/* sound: hum + low pulse until the punch; silence; then the score for Acts 4–5 */}
    <Sequence durationInFrames={s(28.9)}><Audio src={a("sfx/roomtone.wav")} volume={0.45} /></Sequence>
    <Sequence from={s(14)} durationInFrames={s(14.9)}><Audio src={a("music/mixkit_614.mp3")} startFrom={s(20)} volume={(f) => interpolate(f, [0, 20, s(14.9)], [0, 0.26, 0.34], clamp)} /></Sequence>
    <Sequence from={s(35)} durationInFrames={s(35.5)}><Audio src={a("music/mixkit_473.mp3")} volume={(f) => interpolate(f, [0, 30, s(33), s(35.5)], [0, 0.28, 0.28, 0], clamp)} /></Sequence>
    <Sequence from={s(67.5)} durationInFrames={s(8.5)}><Audio src={a("sfx/roomtone.wav")} volume={0.35} /></Sequence>
  </AbsoluteFill>
);

