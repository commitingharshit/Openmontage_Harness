export const Freeze: React.FC<{ img?: string; video?: string; from?: number; x: number; y: number; w: number; h: number; fill?: number; children?: React.ReactNode }> = ({ img, video, from = 0, x, y, w, h, fill = 0.9, children }) => {
  const { width: VW, height: VH } = useVideoConfig();
  const z = Math.min(VW / w, VH / h) * fill;
  const tx = VW / 2 - (x + w / 2) * z, ty = VH / 2 - (y + h / 2) * z;
  const st: React.CSSProperties = { position: "absolute", left: 0, top: 0, width: 1920, height: 1080, transform: `translate(${tx}px, ${ty}px) scale(${z})`, transformOrigin: "0 0" };
  return (
    <AbsoluteFill style={{ background: "#0b0d12", overflow: "hidden" }}>
      {img ? <Img src={a(`frames/${img}`)} style={st} /> : <OffthreadVideo src={a(video!)} startFrom={s(from)} muted style={st} />}
      {children}
    </AbsoluteFill>
  );
};

export const Footer: React.FC<{ text: string }> = ({ text }) => (
  <div style={{ position: "absolute", left: 0, right: 0, bottom: 46, textAlign: "center" }}>
    <span style={{ fontFamily: ui, fontWeight: 700, fontSize: 46, color: "white", background: "rgba(5,7,10,.8)", padding: "10px 26px", borderRadius: 12 }}>{text}</span>
  </div>
);

// Source-space regions on the 1920×1080 ui3 frames.
export const BUBBLE = { x: 1630, y: 280, w: 280, h: 130 };          // request bubble (u3_22)
export const PANEL = { x: 1630, y: 255, w: 290, h: 200 };           // Changes panel header + Accept all (u3_39.2 / u3_40.8)

export const EndCard: React.FC = () => (
  <AbsoluteFill style={{ background: "#0b0d12", justifyContent: "center", alignItems: "center", fontFamily: ui, color: "white" }}>
    <div style={{ fontSize: 110, fontWeight: 800, letterSpacing: -3 }}>Agentic Office</div>
    <div style={{ fontSize: 58, marginTop: 10, color: "#dfe3ea" }}>AI drives. You approve.</div>
    <div style={{ marginTop: 56, fontSize: 40, padding: "16px 40px", borderRadius: 999, border: "2px solid #4a5263" }}>Request early access</div>
    <div style={{ position: "absolute", bottom: 60, fontSize: 32, color: "#c7ccd6" }}>Can make mistakes. You review every change.</div>
  </AbsoluteFill>
);

export const DiffsEndCard: React.FC<{ vertical?: boolean }> = ({ vertical }) => (
  <AbsoluteFill style={{ background: "#0b0d12", justifyContent: "center", alignItems: "center", fontFamily: ui, color: "white", textAlign: "center", padding: vertical ? "0 70px" : 0 }}>
    <div style={{ fontSize: 34, letterSpacing: 8, color: "#9fb4ff" }}>INTRODUCING</div>
    <div style={{ fontSize: vertical ? 150 : 140, fontWeight: 800, letterSpacing: -4, marginTop: 6 }}>Diffs</div>
    <div style={{ fontSize: vertical ? 58 : 54, color: "#dfe3ea", marginTop: 4 }}>in Agentic Office</div>
    <div style={{ fontSize: vertical ? 44 : 38, color: "#b9c0cc", marginTop: 34, maxWidth: vertical ? 900 : 1300, lineHeight: 1.35 }}>Every change across your model, memo and deck. Accept or reject each one.</div>
    <div style={{ marginTop: 50, fontSize: 40, padding: "16px 40px", borderRadius: 999, border: "2px solid #4a5263" }}>Request early access</div>
    <div style={{ position: "absolute", bottom: vertical ? 120 : 60, fontSize: vertical ? 36 : 32, color: "#c7ccd6" }}>Can make mistakes. You review every change.</div>
  </AbsoluteFill>
);

