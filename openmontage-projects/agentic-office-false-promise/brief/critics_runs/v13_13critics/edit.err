// Agentic Office — v13 "Introducing Diffs" (82 s). v12's script, rebuilt to the cinematic-ad visual + sound rules:
// every screen is an in-world shot (real UI corner-pinned into the Meta AI laptop stills) or UI-in-space over a blurred
// set plate; a burst grind; one finish (grade, grain, vignette) over everything; room tone under the whole film;
// a spotted SFX pass; music ducked under every VO line; a second cue that resolves on the accept.
import React from "react";
import { AbsoluteFill, Audio, Img, interpolate, OffthreadVideo, Sequence, staticFile, useCurrentFrame, useVideoConfig } from "remotion";
import { Line, Plate, Sfx, Shot } from "./AODone";
import {
  B1Hook, B3David, B5Excel, B6Word, B8Compare, B9HerSlide, B10Punch, BUBBLE, C, DeskBg, DiffsEndCard, Footer, Freeze, Label, Mark, PANEL, ui,
} from "./AOv10";
import { HookTiles } from "./AOv11";

const FPS = 30;
const s = (sec: number) => Math.round(sec * FPS);
const a = (p: string) => staticFile(`aofp/${p}`);
const clamp = { extrapolateLeft: "clamp", extrapolateRight: "clamp" } as const;
type Quad = [number, number][];

// Screen corners (TL, TR, BR, BL) in 1920×1080 plate space, detected by cv2 (visuals/meta/screens.json).
const SCREENS: Record<string, Quad> = {
  m01_ots: [[680.5, 492.8], [1159.4, 446.8], [1191.4, 780.1], [712.5, 826.1]],
  m06_dawn: [[345.0, 622.5], [608.4, 592.5], [659.1, 760.3], [401.2, 797.8]],
  m08_topdown: [[649.7, 191.2], [1244.1, 187.5], [1207.5, 381.6], [687.2, 381.6]],
};

// Homography mapping the 1920×1080 content rectangle onto a quad, as a CSS matrix3d.
const pin = (q: Quad, W = 1920, H = 1080) => {
  const src: Quad = [[0, 0], [W, 0], [W, H], [0, H]];
  const A: number[][] = [];
  src.forEach(([x, y], i) => {
    const [u, v] = q[i];
    A.push([x, y, 1, 0, 0, 0, -u * x, -u * y, u]);
    A.push([0, 0, 0, x, y, 1, -v * x, -v * y, v]);
  });
  for (let c = 0; c < 8; c++) {
    let p = c;
    for (let r = c + 1; r < 8; r++) if (Math.abs(A[r][c]) > Math.abs(A[p][c])) p = r;
    [A[c], A[p]] = [A[p], A[c]];
    for (let r = 0; r < 8; r++) if (r !== c) {
      const k = A[r][c] / A[c][c];
      for (let j = c; j < 9; j++) A[r][j] -= k * A[c][j];
    }
  }
  const h = A.map((r, i) => r[8] / r[i]);
  return `matrix3d(${h[0]},${h[3]},0,${h[6]},${h[1]},${h[4]},0,${h[7]},0,0,1,0,${h[2]},${h[5]},0,1)`;
};

// A slow camera move on a still (push toward a point), with a touch of handheld drift when asked.
const useCam = (z0: number, z1: number, shake = 0) => {
  const f = useCurrentFrame();
  const { durationInFrames } = useVideoConfig();
  const z = interpolate(f, [0, durationInFrames], [z0, z1], { ...clamp, easing: (t) => 1 - Math.pow(1 - t, 2) });
  const dx = shake * (Math.sin(f / 7.3) * 0.6 + Math.sin(f / 3.1) * 0.4), dy = shake * (Math.cos(f / 6.1) * 0.6 + Math.sin(f / 4.3) * 0.4);
  return { z, dx, dy };
};

// IN-WORLD: the still plate with the real UI (or a block) on its laptop screen; camera pushes toward the screen.
const OnScreen: React.FC<{ still: keyof typeof SCREENS; z0?: number; z1?: number; shake?: number; children: React.ReactNode }> = ({ still, z0 = 1.05, z1 = 1.35, shake = 0, children }) => {
  const q = SCREENS[still];
  const cx = q.reduce((t, p) => t + p[0], 0) / 4, cy = q.reduce((t, p) => t + p[1], 0) / 4;
  const { z, dx, dy } = useCam(z0, z1, shake);
  return (
    <AbsoluteFill style={{ background: "#000", overflow: "hidden" }}>
      <div style={{ position: "absolute", width: 1920, height: 1080, transformOrigin: `${cx}px ${cy}px`, transform: `translate(${dx}px, ${dy}px) scale(${z})` }}>
        <Img src={a(`${still}.png`)} style={{ position: "absolute", width: 1920, height: 1080 }} />
        <div style={{ position: "absolute", left: 0, top: 0, width: 1920, height: 1080, transformOrigin: "0 0", transform: pin(q), overflow: "hidden", filter: "brightness(.86) contrast(1.04) saturate(.9) blur(.35px)" }}>
          {children}
          {/* glass: a soft diagonal reflection and edge falloff */}
          <div style={{ position: "absolute", inset: 0, background: "linear-gradient(115deg, rgba(255,255,255,.07) 0%, rgba(255,255,255,0) 38%), radial-gradient(ellipse at 50% 50%, rgba(0,0,0,0) 60%, rgba(0,0,0,.35) 100%)" }} />
        </div>
      </div>
    </AbsoluteFill>
  );
};

// UI IN SPACE: the real UI on an angled plane, floating over a blurred, dimmed set plate.
const InSpace: React.FC<{ bg?: string; turn?: number; children: React.ReactNode }> = ({ bg = "m01_ots", turn = 1, children }) => {
  const f = useCurrentFrame();
  const { durationInFrames } = useVideoConfig();
  const p = f / durationInFrames;
  const ry = turn * interpolate(p, [0, 1], [-7, -3]);
  const sc = interpolate(p, [0, 1], [0.8, 0.84]);
  return (
    <AbsoluteFill style={{ background: "#05070a", overflow: "hidden", perspective: 2600 }}>
      <Img src={a(`${bg}.png`)} style={{ position: "absolute", inset: -40, width: 2000, height: 1160, filter: "blur(22px) brightness(.42) saturate(.8)", transform: `scale(${1.05 + 0.04 * p})` }} />
      <div style={{ position: "absolute", left: 0, top: 0, width: 1920, height: 1080, transform: `rotateY(${ry}deg) rotateX(2deg) scale(${sc})`, borderRadius: 18, overflow: "hidden", boxShadow: "0 60px 160px rgba(0,0,0,.75), 0 0 0 1px rgba(255,255,255,.06)", filter: "brightness(.9) contrast(1.03)" }}>
        {children}
        <div style={{ position: "absolute", inset: 0, background: "linear-gradient(110deg, rgba(255,255,255,.06), rgba(255,255,255,0) 40%)", pointerEvents: "none" }} />
      </div>
    </AbsoluteFill>
  );
};

// A still as a moving plate (no screen content).
const Still: React.FC<{ img: string; z0?: number; z1?: number; ox?: number; oy?: number; shake?: number }> = ({ img, z0 = 1.04, z1 = 1.12, ox = 960, oy = 540, shake = 0 }) => {
  const { z, dx, dy } = useCam(z0, z1, shake);
  return (
    <AbsoluteFill style={{ background: "#000", overflow: "hidden" }}>
      <Img src={a(`${img}.png`)} style={{ position: "absolute", width: 1920, height: 1080, transformOrigin: `${ox}px ${oy}px`, transform: `translate(${dx}px, ${dy}px) scale(${z})` }} />
    </AbsoluteFill>
  );
};

// A blurred plate behind a transparent-desk block (texts, the punch).
const Over: React.FC<{ bg: string; dim?: number; children: React.ReactNode }> = ({ bg, dim = 0.5, children }) => {
  const f = useCurrentFrame();
  return (
    <AbsoluteFill style={{ background: "#000", overflow: "hidden" }}>
      <Img src={a(`${bg}.png`)} style={{ position: "absolute", width: 1920, height: 1080, filter: `blur(10px) brightness(${1 - dim})`, transform: `scale(${1.06 + f * 0.0006})` }} />
      <DeskBg.Provider value="transparent">{children}</DeskBg.Provider>
    </AbsoluteFill>
  );
};

const SpedUp: React.FC = () => (
  <div style={{ position: "absolute", top: 34, right: 44, fontFamily: ui, fontSize: 26, color: "rgba(255,255,255,.85)", background: "rgba(0,0,0,.55)", padding: "6px 14px", borderRadius: 8, zIndex: 9 }}>Real app · sped up</div>
);

const Super: React.FC<{ children: React.ReactNode; bottom?: number }> = ({ children, bottom = 90 }) => {
  const f = useCurrentFrame();
  return (
    <AbsoluteFill style={{ justifyContent: "flex-end", alignItems: "center", paddingBottom: bottom, opacity: interpolate(f, [0, 6], [0, 1], clamp) }}>
      <div style={{ fontFamily: ui, fontSize: 66, fontWeight: 800, color: "white", textAlign: "center", lineHeight: 1.14, letterSpacing: -1, textShadow: "0 6px 30px rgba(0,0,0,.85)" }}>{children}</div>
    </AbsoluteFill>
  );
};

// One finish over everything: grade, halation-ish bloom, vignette, animated grain.
const Finish: React.FC = () => {
  const f = useCurrentFrame();
/Users/harshitverma/Desktop/OpenMontage/remotion-composer/src/AOv13.tsx:9:  B1Hook, B3David, B5Excel, B6Word, B8Compare, B9HerSlide, B10Punch, BUBBLE, C, DeskBg, DiffsEndCard, Footer, Freeze, Label, Mark, PANEL, ui,
