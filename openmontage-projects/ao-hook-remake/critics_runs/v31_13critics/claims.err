[{"t": 0.4, "text": "Nine A.M. Board meeting. And the deck doesn't match the model."}, {"t": 6.0, "text": "You ask a chatbot to update the board memo."}, {"t": 11.0, "text": "It says it's done."}, {"t": 12.5, "text": "Then you open the file... and the formatting's wrecked."}, {"t": 15.55, "text": "So you fix it by hand. Then, an email."}, {"t": 18.15, "text": "Please update the model and the board deck to match, before the meeting."}, {"t": 24.0, "text": "So you ask it for the deck... and it builds one, in the chat."}, {"t": 28.35, "text": "Then, one number changes."}, {"t": 30.2, "text": "Prompt again. Wait again. Five minutes... for one number."}, {"t": 34.6, "text": "Done. Except now... slide four changed."}, {"t": 37.6, "text": "Five tabs. Copy. Paste. Check. Repeat."}, {"t": 42.3, "text": "The worst part? You don't even know what's wrong anymore."}, {"t": 46.3, "text": "See exactly what changed. Decide what stays."}, {"t": 49.9, "text": "Meet Agentic Office. Your Word, Excel and PowerPoint, in one workspace."}, {"t": 55.1, "text": "Tell it what changed. Once."}, {"t": 57.0, "text": "It finds where that number lives: the model, the memo, the deck."}, {"t": 60.45, "text": "And drafts each fix in place, for you to review."}, {"t": 64.6, "text": "Every change is marked, in every file. You accept it, or reject it."}, {"t": 69.6, "text": "Even slide four."}, {"t": 75.2, "text": "Done. And this time, you've seen every change."}, {"t": 82.6, "text": "Agentic Office."}]{
