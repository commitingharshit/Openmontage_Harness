        <div style={{position: 'absolute', left: 331 + 990, top: 373 + 8, width: 66, height: 24, borderRadius: 6, boxShadow: `0 0 ${24 * k(t, [65.8, 66.1], [0, 1])}px rgba(40,200,64,.9)`}} /></Lens>
      : <AbsoluteFill style={{transform: `translateY(${scroll}px)`}}>
